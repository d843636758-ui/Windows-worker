# Cloud server (Zeabur)
MCP_AUTH_TOKEN=replace-with-a-long-random-token
WORKER_SHARED_SECRET=replace-with-another-long-random-token
ALLOW_WORKERS=windows-main
REQUEST_TIMEOUT_MS=180000
MAX_SCREENSHOT_BYTES=5000000
LOG_LEVEL=info
PORT=8080

# Windows worker
RELAY_URL=wss://your-service.zeabur.app/worker
WORKER_ID=windows-main
EDGE_PROFILE_DIR=%LOCALAPPDATA%\AI-Browser-Worker\edge-profile
HEADED=true
ALIPAY_BOT_PATH=alipay-bot
